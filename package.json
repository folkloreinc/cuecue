{
    "name": "cuecue",
    "private": true,
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "babel-node": "./node_modules/.bin/babel-node --config-file=./babel.config.js  -i '[]'",
        "example:server": "DEBUG='cuecue:*' npm run babel-node -- ./examples/server.js",
        "example:lni": "DEBUG='cuecue:*' npm run babel-node -- --trace-warnings ./examples/lni.js ",
        "example:duration": "DEBUG='cuecue:*' npm run babel-node -- --trace-warnings ./examples/duration.js ",
        "example:socketio": "DEBUG='cuecue:*' npm run babel-node -- ./examples/socketio.js",
        "example:socketio-client": "DEBUG='cuecue:*' npm run babel-node -- ./examples/socketio-client.js",
        "debug:lni": "DEBUG='cuecue:*' nodemon --exec npm run babel-node -- ./examples/lni.js",
        "migrate:store:up": "npm run migrate:up -w @cuecue/store-mysql",
        "migrate:store:down": "npm run migrate:down -w @cuecue/store-mysql",
        "changeset": "changeset",
        "version-packages": "changeset version && npm install --package-lock-only"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/cuecue.git"
    },
    "author": "Folklore <dev@folklore.email>",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/folkloreinc/cuecue/issues"
    },
    "homepage": "https://github.com/folkloreinc/cuecue#readme",
    "engines": {
        "node": ">=22"
    },
    "workspaces": [
        "packages/core",
        "packages/app",
        "packages/http",
        "packages/osc",
        "packages/pingpong",
        "packages/pubnub",
        "packages/socketio",
        "packages/store-mysql",
        "packages/cli"
    ],
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.13",
        "@babel/node": "^7.29.7",
        "@babel/preset-env": "^7.29.14",
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "dotenv": "^18.0.10",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.10.1",
        "rollup": "^4.68.5",
        "vitest": "^5.1.0"
    }
}
